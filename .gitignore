__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/
desktop.ini
out/
outputs/

# Deterministic tutorial CSVs are generated from the committed generator + SHA256 manifest.
examples/sample-data/*.csv

# Local HF cache overrides are never committed.
hf-cache/

# Model weights are pulled locally; only small config/tokenizer files and the
# dimer-base-manifest.json are committable
weights/**/*.safetensors
weights/**/*.ckpt
weights/**/*.bin
weights/**/*.pt
weights/**/*.pth
weights/**/*.onnx
weights/**/.cache/
